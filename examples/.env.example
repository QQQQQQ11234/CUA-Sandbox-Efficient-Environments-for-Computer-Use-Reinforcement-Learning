# Copy to .env and load it in your shell. Do not commit the filled file.
WEB_AGENT_ISOLATION_MODE=db
ROUTE_TOKEN_SECRET=replace-with-at-least-32-random-bytes

# WebArena-compatible service authorities
SHOPPING_SITE_AUTHORITY=shopping.local:7770
SHOPPING_ADMIN_SITE_AUTHORITY=shopping-admin.local:7780
REDDIT_SITE_AUTHORITY=reddit.local:9999
GITLAB_SITE_AUTHORITY=gitlab.local:8023
MAP_SITE_AUTHORITY=map.local:3000
WIKIPEDIA_SITE_AUTHORITY=wikipedia.local:8888

# Shared-runtime backend (required only for WEB_AGENT_ISOLATION_MODE=db)
DB_ADMIN_DSN=postgresql://postgres:postgres@127.0.0.1:5432/postgres
DB_BASE_TEMPLATE=webarena_template
DB_CLONE_STRATEGY=FILE_COPY
ROUTE_REGISTRY_PATH=./runtime/db_routes.sqlite3
SHOPPING_SHARED_TARGET=127.0.0.1:7772
SHOPPING_ADMIN_SHARED_TARGET=127.0.0.1:7772

# Optional model and evaluator endpoints
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
EVALUATOR_LLM_BASE_URL=http://127.0.0.1:8000/v1
EVALUATOR_LLM_API_KEY=EMPTY
EVALUATOR_LLM_MODEL=openai/Qwen/Qwen3.5-9B

# Site accounts: use deployment-specific values
SHOPPING_USERNAME=
SHOPPING_PASSWORD=
SHOPPING_ADMIN_USERNAME=
SHOPPING_ADMIN_PASSWORD=
SHOPPING_CMS_USERNAME=
SHOPPING_CMS_PASSWORD=
REDDIT_USERNAME=
REDDIT_PASSWORD=
GITLAB_USERNAME=
GITLAB_PASSWORD=
